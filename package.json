    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@reticlehq/next": "^3.3.0",
    "@reticlehq/react": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.1",
